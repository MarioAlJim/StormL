precision mediump float;

varying vec2 v_texcoord_0;

uniform sampler2D s_diffuse;
uniform sampler2D s_detail;

uniform vec4 u_color_0;
uniform vec4 u_color_1;

void main()
{
	vec4 texture1 = texture2D( s_diffuse, v_texcoord_0 ) * u_color_0;
	vec4 texture2 = texture2D( s_detail, v_texcoord_0 ) * u_color_1;
	
	gl_FragColor = texture1 + texture2;
}
